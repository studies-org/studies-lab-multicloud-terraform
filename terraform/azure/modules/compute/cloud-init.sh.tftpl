#!/bin/bash
# Renderizado pelo Terraform (templatefile). Roda uma vez no primeiro boot.
set -euo pipefail

apt-get update
apt-get install -y apache2

mkdir -p /opt/site
echo '${site_html_b64}' | base64 -d > /opt/site/index.html
echo '${render_sh_b64}' | base64 -d > /opt/site/render.sh
chmod +x /opt/site/render.sh

# Região e fault domain reais, lidos do Instance Metadata Service
imds() { curl -s -H Metadata:true "http://169.254.169.254/metadata/instance/compute/$1?api-version=2021-02-01&format=text"; }

CLOUD=Azure CLOUD_KEY=azure INSTANCE='${instance_name}' \
  REGION="$(imds location)" ZONE="fault domain $(imds platformFaultDomain)" \
  LB="Azure Load Balancer" SERVER="Apache2" \
  /opt/site/render.sh /opt/site/index.html /var/www/html/index.html

systemctl enable --now apache2
