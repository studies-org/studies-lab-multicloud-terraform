#!/bin/bash
# Renderizado pelo Terraform (templatefile). Roda uma vez no primeiro boot.
set -euo pipefail

dnf install -y httpd

mkdir -p /opt/site
echo '${site_html_b64}' | base64 -d > /opt/site/index.html
echo '${render_sh_b64}' | base64 -d > /opt/site/render.sh
chmod +x /opt/site/render.sh

# Região e AZ reais, lidas do IMDSv2
TOKEN=$(curl -s -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
imds() { curl -s -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/$1"; }

CLOUD=AWS CLOUD_KEY=aws INSTANCE='${instance_name}' \
  REGION="$(imds placement/region)" ZONE="$(imds placement/availability-zone)" \
  LB="Application Load Balancer" SERVER="Apache httpd" \
  /opt/site/render.sh /opt/site/index.html /var/www/html/index.html

systemctl enable --now httpd
